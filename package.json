{
  "name": "boulder-clicker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:test": "vite --port 5184",
    "test": "node --test test/*.test.mjs",
    "test:quick": "node --test test/boards.test.mjs test/frame-rate.test.mjs test/ground.test.mjs test/kit.test.mjs test/ladder.test.mjs test/lab.test.mjs test/muck-reach.test.mjs test/pit.test.mjs test/pit-full.test.mjs test/shaken.test.mjs test/tower.test.mjs",
    "test:watch": "node --test --watch test/*.test.mjs",
    "test:browser": "node tools/headless.mjs",
    "test:browser:par": "node tools/test.mjs",
    "test:browser:serial": "node tools/headless.mjs --serial",
    "test:all": "node --test test/*.test.mjs && node tools/headless.mjs",
    "watch": "node --test --watch",
    "look": "node tools/look.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  }
}
