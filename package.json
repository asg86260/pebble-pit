{
  "name": "boulder-clicker",
  "private": true,
  "version": "0.2.1",
  "description": "A black-and-white pixel clicker about a rock, a hole and the people between them.",
  "author": "Andrew Graham",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:test": "vite --port 5184",
    "test": "node tools/sweep.mjs --lock node -- node --test --test-concurrency=4 test/*.test.mjs",
    "test:quick": "node --test --test-concurrency=4 test/boards.test.mjs test/frame-rate.test.mjs test/ground.test.mjs test/kit.test.mjs test/ladder.test.mjs test/lab.test.mjs test/muck-reach.test.mjs test/pit.test.mjs test/pit-full.test.mjs test/shaken.test.mjs test/tower.test.mjs",
    "test:watch": "node --test --test-concurrency=4 --watch test/*.test.mjs",
    "test:browser": "node tools/sweep.mjs --lock browser -- node tools/headless.mjs",
    "test:browser:par": "node tools/sweep.mjs --lock browser -- node tools/test.mjs",
    "test:browser:serial": "node tools/sweep.mjs --lock browser -- node tools/headless.mjs --serial",
    "test:all": "npm test && npm run test:browser",
    "watch": "node --test --watch",
    "look": "node tools/look.mjs",
    "zip": "node tools/zip.mjs",
    "desk": "electron .",
    "desk:build": "node tools/desk-build.mjs",
    "publish": "node tools/publish.mjs",
    "release": "node tools/release.mjs"
  },
  "config": {
    "itch": "cameldash/pebble-pit"
  },
  "build": {
    "appId": "com.boulderclicker.desk",
    "productName": "Pebble Pit",
    "files": ["dist/**", "electron/**"],
    "electronLanguages": ["en-US"],
    "icon": "build/icon.png",
    "directories": { "output": "release" },
    "win": { "target": ["nsis", "portable"] },
    "portable": { "artifactName": "${productName} ${version} portable.exe" },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] }
  },
  "devDependencies": {
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.3"
  }
}
