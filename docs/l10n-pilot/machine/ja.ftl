         [0] { $who }
         [1] 第2の{ $who }
         [2] 第三{ $who }
         [3] 第437章
        *[other] 未定義の{ $who }
    }

# a deep station not yet given a fighter; $nth counts the empty lots before it (a fifth reads "undefined", as the code said)
